# Copy to .env and edit.  Generate a token:  python -c "import secrets;print(secrets.token_urlsafe(32))"

# --- Auth (required for remote use) ---
MCP_FS_TOKEN=change-me-to-a-long-random-string
# One token per AI/client (comma separated) so you can revoke one without the others:
# MCP_FS_TOKENS=token-for-claude,token-for-cursor,token-for-my-agent

# --- Network ---
MCP_FS_HOST=0.0.0.0
MCP_FS_PORT=8765
MCP_FS_PATH=/mcp
# REQUIRED behind a tunnel or domain (ngrok, cloudflared, Caddy, nginx), otherwise every
# request gets "421 Misdirected Request". Wildcards ok, "*" allows any host.
# MCP_FS_ALLOWED_HOSTS=mcp.example.com
# MCP_FS_ALLOWED_HOSTS=*.ngrok-free.app,*.trycloudflare.com
# Browser-style origins allowed to call it (fixes "403 Forbidden Origin"):
# MCP_FS_ALLOWED_ORIGINS=https://claude.ai

# Accept the token in the URL for apps that can't send an Authorization header:
#   https://your-domain/<token>   (token must be 16+ chars; keep the URL private)
# MCP_FS_URL_TOKEN=true

# --- What the AI can touch ---
# Folder the file tools are locked to (commands also start here):
MCP_FS_ROOT=./workspace
MCP_FS_READ_ONLY=false
MCP_FS_ALLOW_COMMANDS=true
MCP_FS_ALLOW_DELETE=true
MCP_FS_ALLOW_HIDDEN=true
# Files the AI may never read/write/list (globs, comma separated):
MCP_FS_DENY_GLOBS=.env,*.pem,*.key,id_rsa*,.git/config

# --- Limits ---
MCP_FS_MAX_READ_BYTES=5000000
MCP_FS_MAX_WRITE_BYTES=20000000
MCP_FS_MAX_OUTPUT_CHARS=100000
MCP_FS_COMMAND_TIMEOUT=120
MCP_FS_MAX_COMMAND_TIMEOUT=1800
MCP_FS_MAX_PROCESSES=16

# Shell for commands (default: bash, else /bin/sh; Windows: cmd.exe). Examples: /bin/zsh, pwsh
# MCP_FS_SHELL=/bin/bash

# MCP_FS_LOG_LEVEL=warning
